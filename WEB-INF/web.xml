<?xml version="1.0" encoding="UTF-8"?>
<!--
  Complete deployment descriptor for Unit-II Basic Servlets (WIT Solapur).
  Container: Apache Tomcat 11.0.24  |  API: Jakarta Servlet 6.1 (jakarta.servlet.*)
  Each <servlet> registers a Java class. Each <servlet-mapping> binds a URL.
  The two <servlet-name> values must be identical. url-pattern is the path after /basic-servlets.
-->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
         https://jakarta.ee/xml/ns/jakartaee/web-app_6_1.xsd"
         version="6.1">

    <display-name>Unit-II Basic Servlet Programs</display-name>
    <!-- reload-token: notes-complete-1500 -->

    <!-- ServletContext: shared by EVERY servlet (college letterhead). Read: getServletContext().getInitParameter(name) -->
    <context-param>
        <param-name>collegeName</param-name>
        <param-value>Walchand Institute of Technology, Solapur</param-value>
    </context-param>
    <context-param>
        <param-name>department</param-name>
        <param-value>Computer Science and Engineering</param-value>
    </context-param>
    <context-param>
        <param-name>subject</param-name>
        <param-value>Advanced Java (Unit-II Servlets)</param-value>
    </context-param>
    <!-- Notes PDF examples use context-param name -->
    <context-param>
        <param-name>name</param-name>
        <param-value>Walchand Institute of Technology</param-value>
    </context-param>

    <!-- Servlet 1: Hello Servlet. Logical name HelloServlet maps URL /hello to class HelloServlet -->
    <servlet>
        <servlet-name>HelloServlet</servlet-name>
        <servlet-class>HelloServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HelloServlet</servlet-name>
        <url-pattern>/hello</url-pattern>
    </servlet-mapping>

    <!-- Servlet 2: GET vs POST Demo -->
    <servlet>
        <servlet-name>GetPostDemoServlet</servlet-name>
        <servlet-class>GetPostDemoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GetPostDemoServlet</servlet-name>
        <url-pattern>/getpost</url-pattern>
    </servlet-mapping>

    <!-- ICA 01 / Chapter 2: one URL /httpmethods, six HTTP verbs (GET search, POST register, PUT city, DELETE, OPTIONS, TRACE) -->
    <servlet>
        <servlet-name>HttpMethodsServlet</servlet-name>
        <servlet-class>HttpMethodsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HttpMethodsServlet</servlet-name>
        <url-pattern>/httpmethods</url-pattern>
    </servlet-mapping>

    <!-- Sample registration form only (POST). Not mixed with HttpMethodsServlet. -->
    <servlet>
        <servlet-name>SampleRegisterServlet</servlet-name>
        <servlet-class>SampleRegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SampleRegisterServlet</servlet-name>
        <url-pattern>/sampleregister</url-pattern>
    </servlet-mapping>

    <!-- ICA 03 / Chapter 4: lifecycle. load-on-startup 1 = call init when the app starts, not only on first hit -->
    <servlet>
        <servlet-name>LifecycleServlet</servlet-name>
        <servlet-class>LifecycleServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>LifecycleServlet</servlet-name>
        <url-pattern>/lifecycle</url-pattern>
    </servlet-mapping>

    <!-- ICA 04 / Chapter 5: ServletConfig init-param (this servlet only) vs context-param (whole app, above) -->
    <servlet>
        <servlet-name>ConfigContextServlet</servlet-name>
        <servlet-class>ConfigContextServlet</servlet-class>
        <init-param>
            <param-name>author</param-name>
            <param-value>Student Name</param-value>
        </init-param>
        <init-param>
            <param-name>practicalNo</param-name>
            <param-value>5</param-value>
        </init-param>
        <init-param>
            <param-name>topic</param-name>
            <param-value>ServletConfig and ServletContext</param-value>
        </init-param>
    </servlet>
    <servlet-mapping>
        <servlet-name>ConfigContextServlet</servlet-name>
        <url-pattern>/configcontext</url-pattern>
    </servlet-mapping>

    <!-- ICA 05 / Chapter 6: forward keeps URL /forward; sendRedirect changes URL to /target -->
    <servlet>
        <servlet-name>ForwardServlet</servlet-name>
        <servlet-class>ForwardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ForwardServlet</servlet-name>
        <url-pattern>/forward</url-pattern>
    </servlet-mapping>

    <!-- Servlet 7: Redirect -->
